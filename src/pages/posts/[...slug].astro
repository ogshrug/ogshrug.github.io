---
import Base from '../../layouts/Base.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft)
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const date = post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
---
<Base title={post.data.title} description={post.data.description}>
  <h1 class="page-title">{post.data.title}</h1>
  <p class="page-sub mono" style="font-style:normal;font-size:.85rem">{date}</p>
  <article class="prose">
    <Content />
  </article>
  <p style="margin-top:4rem"><a class="u" href={`${base}/posts`}>← All writing</a></p>
</Base>
